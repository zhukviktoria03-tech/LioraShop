{
  "name": "liora-landing-cms",
  "version": "1.0.0",
  "overrides": {
    "drizzle-kit": "0.23.2"
  },
  "description": "Payload CMS backend for Liora cosmetics landing page",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env TS_NODE_PROJECT=tsconfig.json nodemon",
    "build": "tsc && payload build",
    "serve": "cross-env NODE_ENV=production node dist/server.js",
    "generate:types": "cross-env TS_NODE_PROJECT=tsconfig.json ts-node src/generateTypes.ts"
  },
  "dependencies": {
    "@payloadcms/bundler-webpack": "^1.0.7",
    "@payloadcms/db-postgres": "^0.8.10",
    "@payloadcms/richtext-slate": "^1.5.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "payload": "^2.20.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
